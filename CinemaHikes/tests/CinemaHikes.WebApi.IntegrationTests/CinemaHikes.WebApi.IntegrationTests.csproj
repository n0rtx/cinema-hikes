<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>CinemaHikes.WebApi.IntegrationTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- xUnit -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Assertions -->
        <PackageReference Include="FluentAssertions" Version="6.12.2" />

        <!-- Integration testing -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

        <!-- EF Core InMemory (самый простой вариант для начала) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />

        <!-- Если будешь использовать Testcontainers + Postgres (рекомендую позже) -->
        <!-- <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" /> -->
        <!-- <PackageReference Include="Respawn" Version="6.2.1" /> -->
    </ItemGroup>

    <ItemGroup>
        <!-- Ссылка на WebApi (обязательно) -->
        <ProjectReference Include="..\..\src\CinemaHikes.WebApi\CinemaHikes.WebApi.csproj" />

        <!-- Обычно также полезно иметь доступ к Application и Infrastructure -->
        <ProjectReference Include="..\..\src\CinemaHikes.Application\CinemaHikes.Application.csproj" />
        <ProjectReference Include="..\..\src\CinemaHikes.Infrastructure\CinemaHikes.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CinemaHikes.Infrastructure\CinemaHikes.Infrastructure.csproj" />
    </ItemGroup>

</Project>